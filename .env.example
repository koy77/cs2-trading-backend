APP_NAME="CS2 Trading Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_PORT=18090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cs2
DB_USERNAME=cs2
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
# хост-порт MySQL (для внешних клиентов, напр. TablePlus)
MYSQL_HOST_PORT=33061

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Очереди — RabbitMQ (5 очередей: inventory.sync, prices.refresh, orders.fulfill, trades.poll, webhooks.out + DLQ)
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=cs2
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/
RABBITMQ_UI_PORT=25674

CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Steam (без API-ключей) ---
# real — живые запросы к steamcommunity.com (с троттлингом); fixture — слепки реальных профилей (CI/страховка)
STEAM_PROVIDER=real
STEAM_HTTP_MIN_INTERVAL=1.0
STEAM_PRICE_CACHE_TTL=180
STEAM_FIXTURES_PATH=database/fixtures/steam
# главный публичный профиль для демо (Kyle, 82 предмета) — можно переопределить
STEAM_DEMO_PROFILE=76561199104360494

# --- Платёжный провайдер (mock-psp сервис) ---
PSP_BASE_URL=http://mock-psp:8081
PSP_WEBHOOK_SECRET=dev-secret
PSP_WEBHOOK_WINDOW=300
MOCK_PSP_PORT=18092

# --- Перф-режим (make perf): лёгкий батч-сид, по умолчанию не запускается ---
PERF_ROWS=100000

# --- Мониторинг (профиль monitoring: Prometheus + Grafana) ---
PROMETHEUS_PORT=19091
GRAFANA_PORT=13001

ADMINER_PORT=18097

MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
